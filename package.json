{
  "name": "@cipherdex/protocol-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:dist": "node scripts/check-sdk-dist.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.13.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Innovutech/cipherdex-protocol-sdk.git"
  }
}
